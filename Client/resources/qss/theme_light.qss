/* LunaChat - Discord 风格日间主题 */
QWidget {
    background-color: #ffffff;
    color: #060607;
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 13px;
}
QMainWindow, QDialog { background-color: #ffffff; }

#Sidebar { background-color: #f2f3f5; border-right: 1px solid #e3e5e8; }
QPushButton#SidebarButton {
    background-color: #e3e5e8;
    color: #060607;
    border: none;
    border-radius: 4px;
    padding: 6px 8px;
}
QPushButton#SidebarButton:hover { background-color: #5865f2; color: #ffffff; }

QListWidget#ChannelList { background-color: transparent; border: none; outline: 0; }
QListWidget#ChannelList::item {
    padding: 8px 10px;
    margin: 2px 6px;
    border-radius: 4px;
    color: #5c5e66;
}
QListWidget#ChannelList::item:hover { background-color: #e3e5e8; color: #060607; }
QListWidget#ChannelList::item:selected { background-color: #d7d9dd; color: #060607; }

QLabel#ChatTitle {
    color: #060607;
    font-size: 15px;
    font-weight: 700;
    padding: 12px 14px;
    border-bottom: 1px solid #e3e5e8;
    background-color: #ffffff;
}
QScrollArea#MessageList { background-color: #ffffff; border: none; outline: 0; }
QWidget#MessageRow { background-color: transparent; }
QWidget#MessageRow:hover { background-color: #f7f8f9; }
QLabel#Avatar {
    background-color: #5865f2;
    color: #ffffff;
    border-radius: 18px;
    font-weight: 700;
    font-size: 15px;
}
QLabel#AvatarSelf {
    background-color: #b5bac1;
    color: #ffffff;
    border-radius: 18px;
    font-weight: 700;
    font-size: 15px;
}
QLabel#MessageHead { color: #060607; font-weight: 600; }
QLabel#MessageBody { color: #2b2d31; }
QLabel#MessageBubble {
    color: #1f2023;
    background-color: #f2f3f5;
    border-radius: 10px;
    padding: 7px 11px;
}

QLineEdit#MessageInput {
    background-color: #ebedef;
    border: none;
    border-radius: 8px;
    padding: 9px 12px;
    color: #060607;
}
QLineEdit#MessageInput:focus { background-color: #e3e5e8; }

QPushButton {
    background-color: #5865f2;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
}
QPushButton:hover { background-color: #4752c4; }
QPushButton:pressed { background-color: #3c45a5; }
QPushButton:disabled { background-color: #e3e5e8; color: #a1a4ab; }

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox, QDateTimeEdit {
    background-color: #f2f3f5;
    border: 1px solid #e3e5e8;
    border-radius: 6px;
    padding: 6px 8px;
    color: #060607;
    selection-background-color: #5865f2;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: #5865f2; }

QListWidget, QTableWidget, QScrollArea, QListView {
    background-color: #ffffff;
    border: 1px solid #e3e5e8;
    border-radius: 6px;
    outline: 0;
}
QListWidget::item, QTableWidget::item { padding: 6px; border-radius: 4px; }
QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #d7d9dd;
    color: #060607;
}
QHeaderView::section {
    background-color: #f2f3f5;
    color: #5c5e66;
    border: none;
    padding: 6px;
    font-weight: 600;
}
QTableWidget { gridline-color: #e3e5e8; }

QMenu { background-color: #ffffff; border: 1px solid #e3e5e8; border-radius: 6px; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 4px; }
QMenu::item:selected { background-color: #5865f2; color: #ffffff; }

QStatusBar { background-color: #f2f3f5; color: #5c5e66; }
QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #e3e5e8;
    text-align: center;
    color: #060607;
    height: 8px;
}
QProgressBar::chunk { background-color: #5865f2; border-radius: 4px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #c4c7cc; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal { background: #c4c7cc; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QLabel#SectionLabel { color: #5c5e66; font-size: 11px; font-weight: 700; padding: 6px 4px 2px 4px; }

/* 最左侧图标栏（Discord 风格） */
QWidget#IconRail { background-color: #eceef2; border-right: 1px solid #dcdfe5; }
QToolButton#RailButton {
    border: none;
    border-radius: 22px;
    background-color: #ffffff;
    color: #4a4c55;
    font-size: 18px;
    font-weight: 700;
}
QToolButton#RailButton:hover { background-color: #e2e4ea; }
QToolButton#RailButton:checked { background-color: transparent; color: #ffffff; }
QLabel#ChatHeaderAvatar { background: #5865f2; color: #ffffff; border-radius: 15px; font-weight: 700; }
QLabel#ChatSubtitle { color: #8b8f98; font-size: 11px; }

QLabel#GroupAvatarBig { background: #5865f2; color: #ffffff; border-radius: 42px; font-size: 30px; font-weight: 700; }

QWidget#RailHighlight { background-color: #5865f2; border-radius: 22px; }

QWidget#MomentBanner { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #5865f2, stop:1 #9b5cf6); }
QLabel#MomentBannerName { color: #ffffff; font-size: 18px; font-weight: 700; }
QLabel#MomentBannerHint { color: #e6e8ff; font-size: 11px; }
QLabel#MomentBannerAvatar { background: #ffffff; color: #5865f2; border-radius: 32px; font-size: 24px; font-weight: 700; }

QWidget#MomentPage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #dbe4ff, stop:0.5 #e9dcff, stop:1 #f4f6fb);
}
QScrollArea#MomentScroll, QWidget#MomentViewport, QWidget#MomentContainer { background: transparent; border: none; }
QFrame#MomentCard {
    background-color: rgba(255, 255, 255, 205);
    border: 1px solid rgba(0, 0, 0, 24);
    border-radius: 10px;
}
QLabel#MomentComments {
    background-color: rgba(0, 0, 0, 16);
    border-radius: 6px;
    padding: 6px 8px;
    color: #4a4c55;
    font-size: 12px;
}
QLabel#MomentBannerName, QLabel#MomentBannerHint, QLabel#MomentBannerAvatar { background: transparent; }
QWidget#MomentBanner { background: transparent; }
/* 卡片内部：文字与头像不能有黑色底 */
QFrame#MomentCard QLabel { background: transparent; }
QFrame#MomentCard QToolButton { background: transparent; border: none; }
QToolButton#MomentAvatar { background: transparent; border: none; }
QToolButton#MomentAvatar:hover { background: rgba(255, 255, 255, 24); border-radius: 22px; }