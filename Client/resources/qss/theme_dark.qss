/* LunaChat - Discord 风格夜间主题（深灰 + blurple 强调） */
QWidget {
    background-color: #1c1d21;
    color: #d7d9de;
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 13px;
}
QMainWindow, QDialog { background-color: #1c1d21; }

/* 左侧栏 */
#Sidebar { background-color: #151619; border-right: 1px solid #0f1012; }
QPushButton#SidebarButton {
    background-color: #3a3d44;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 8px;
}
QPushButton#SidebarButton:hover { background-color: #5865f2; }

/* 会话/频道列表 */
QListWidget#ChannelList {
    background-color: transparent;
    border: none;
    outline: 0;
}
QListWidget#ChannelList::item {
    padding: 8px 10px;
    margin: 2px 6px;
    border-radius: 4px;
    color: #8b8f98;
}
QListWidget#ChannelList::item:hover { background-color: #222429; color: #d7d9de; }
QListWidget#ChannelList::item:selected { background-color: #2b2d33; color: #ffffff; }

/* 聊天区 */
QLabel#ChatTitle {
    color: #f2f3f5;
    font-size: 15px;
    font-weight: 700;
    padding: 12px 14px;
    border-bottom: 1px solid #0f1012;
    background-color: #1c1d21;
}
QScrollArea#MessageList { background-color: #1c1d21; border: none; }
QWidget#MessageRow { background-color: transparent; }
QWidget#MessageRow:hover { background-color: #202226; }
QLabel#Avatar {
    background-color: #5865f2;
    color: #ffffff;
    border-radius: 18px;
    font-weight: 700;
    font-size: 15px;
}
QLabel#AvatarSelf {
    background-color: #3a3d44;
    color: #ffffff;
    border-radius: 18px;
    font-weight: 700;
    font-size: 15px;
}
QLabel#MessageHead { color: #f2f3f5; font-weight: 600; }
QLabel#MessageBody { color: #d7d9de; }
QLabel#MessageBubble {
    color: #e3e5e8;
    background-color: #26282d;
    border-radius: 10px;
    padding: 7px 11px;
}

/* 输入区 */
QLineEdit#MessageInput {
    background-color: #24262b;
    border: none;
    border-radius: 8px;
    padding: 9px 12px;
    color: #d7d9de;
}
QLineEdit#MessageInput:focus { background-color: #2b2d33; }

/* 通用控件 */
QPushButton {
    background-color: #3a3d44;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
}
QPushButton:hover { background-color: #5865f2; }
QPushButton:pressed { background-color: #4752c4; }
QPushButton:disabled { background-color: #26282d; color: #6a6e77; }

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox, QDateTimeEdit {
    background-color: #0f1012;
    border: 1px solid #0f1012;
    border-radius: 6px;
    padding: 6px 8px;
    color: #d7d9de;
    selection-background-color: #5865f2;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: #5865f2; }

QListWidget, QTableWidget, QScrollArea, QListView {
    background-color: #151619;
    border: none;
    border-radius: 6px;
    outline: 0;
}
QListWidget::item, QTableWidget::item { padding: 6px; border-radius: 4px; }
QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #2b2d33;
    color: #ffffff;
}
QHeaderView::section {
    background-color: #151619;
    color: #8b8f98;
    border: none;
    padding: 6px;
    font-weight: 600;
}
QTableWidget { gridline-color: #2a2c31; }

QMenu { background-color: #151619; border: 1px solid #0f1012; border-radius: 6px; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 4px; }
QMenu::item:selected { background-color: #5865f2; color: #ffffff; }

QStatusBar { background-color: #151619; color: #8b8f98; }
QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #0f1012;
    text-align: center;
    color: #d7d9de;
    height: 8px;
}
QProgressBar::chunk { background-color: #5865f2; border-radius: 4px; }
QCheckBox { spacing: 8px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #0b0c0d; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal { background: #0b0c0d; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QLabel#SectionLabel { color: #8b8f98; font-size: 11px; font-weight: 700; padding: 6px 4px 2px 4px; }

/* 最左侧图标栏（Discord 风格） */
QWidget#IconRail { background-color: #0f1012; border-right: 1px solid #0b0c0e; }
QToolButton#RailButton {
    border: none;
    border-radius: 22px;
    background-color: #23252a;
    color: #c9ccd3;
    font-size: 18px;
    font-weight: 700;
}
QToolButton#RailButton:hover { background-color: #2f323a; color: #ffffff; }
QToolButton#RailButton:checked { background-color: transparent; color: #ffffff; }
QLabel#ChatHeaderAvatar { background: #5865f2; color: #ffffff; border-radius: 15px; font-weight: 700; }
QLabel#ChatSubtitle { color: #8b8f98; font-size: 11px; }

QLabel#GroupAvatarBig { background: #5865f2; color: #ffffff; border-radius: 42px; font-size: 30px; font-weight: 700; }

QWidget#RailHighlight { background-color: #5865f2; border-radius: 22px; }

QWidget#MomentBanner { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #5865f2, stop:1 #9b5cf6); }
QLabel#MomentBannerName { color: #ffffff; font-size: 18px; font-weight: 700; }
QLabel#MomentBannerHint { color: #e6e8ff; font-size: 11px; }
QLabel#MomentBannerAvatar { background: #ffffff; color: #5865f2; border-radius: 32px; font-size: 24px; font-weight: 700; }

/* 朋友圈：整页渐变背景，卡片 80% 不透明，文字底全透明 */
QWidget#MomentPage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2b2e4a, stop:0.5 #3a2f52, stop:1 #1f2130);
}
QScrollArea#MomentScroll, QWidget#MomentViewport, QWidget#MomentContainer { background: transparent; border: none; }
QFrame#MomentCard {
    background-color: rgba(46, 49, 58, 205);
    border: 1px solid rgba(255, 255, 255, 28);
    border-radius: 10px;
}
QLabel#MomentComments {
    background-color: rgba(255, 255, 255, 18);
    border-radius: 6px;
    padding: 6px 8px;
    color: #c9ccd3;
    font-size: 12px;
}
QLabel#MomentBannerName, QLabel#MomentBannerHint, QLabel#MomentBannerAvatar { background: transparent; }
QWidget#MomentBanner { background: transparent; }
/* 卡片内部：文字与头像不能有黑色底 */
QFrame#MomentCard QLabel { background: transparent; }
QFrame#MomentCard QToolButton { background: transparent; border: none; }
QToolButton#MomentAvatar { background: transparent; border: none; }
QToolButton#MomentAvatar:hover { background: rgba(255, 255, 255, 24); border-radius: 22px; }